{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/Bielu.BetterSearch.Abstractions/*.csproj",
            "src/Bielu.BetterSearch.Models/*.csproj",
            "src/Bielu.BetterSearch.Core/*.csproj",
            "src/Bielu.BetterSearch.FluentApi/*.csproj",
            "src/Bielu.BetterSearch.ElasticSearch/*.csproj",
            "src/Bielu.BetterSearch.Lifti/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      },
      {
        "src": "..",
        "files": [
          "FEATURE_MATRIX.md",
          "ROADMAP.md"
        ],
        "dest": "articles"
      }
    ],
    "resource": [
      {
        "files": [
          "public/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "markdownEngineName": "markdig",
    "globalMetadata": {
      "_appName": "Bielu.BetterSearch",
      "_appTitle": "Bielu.BetterSearch",
      "_enableSearch": true,
      "_enableNewTab": true,
      "repository": "https://github.com/bielu/bielu.bettersearch",
      "docurl": "https://github.com/bielu/bielu.bettersearch/blob/main/docs"
    }
  }
}
