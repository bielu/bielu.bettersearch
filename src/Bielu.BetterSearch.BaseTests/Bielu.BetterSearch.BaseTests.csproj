<Project Sdk="Microsoft.NET.Sdk">

    <!-- Shared test bases: a plain library, so it references the xunit.v3 attributes without being an executable test host. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- BIELU008 (ConfigureAwait) conflicts with xUnit1030 in test code. -->
        <NoWarn>$(NoWarn);BIELU008</NoWarn>
        <IsTestProject>false</IsTestProject>
        <RootNamespace>Bielu.BetterSearch.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.BetterSearch.Abstractions\Bielu.BetterSearch.Abstractions.csproj" />
    </ItemGroup>

</Project>
