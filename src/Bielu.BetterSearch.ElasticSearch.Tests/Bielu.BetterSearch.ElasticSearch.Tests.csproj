<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- BIELU008 (ConfigureAwait) conflicts with xUnit1030 in test code. -->
        <NoWarn>$(NoWarn);BIELU008</NoWarn>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.MTP" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Testcontainers.Elasticsearch" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Xunit.DependencyInjection" />
        <PackageReference Include="Xunit.DependencyInjection.Logging" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.BetterSearch.BaseTests\Bielu.BetterSearch.BaseTests.csproj" />
      <ProjectReference Include="..\Bielu.BetterSearch.Core\Bielu.BetterSearch.Core.csproj" />
      <ProjectReference Include="..\Bielu.BetterSearch.ElasticSearch\Bielu.BetterSearch.ElasticSearch.csproj" />
      <ProjectReference Include="..\Bielu.BetterSearch.FluentApi\Bielu.BetterSearch.FluentApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
